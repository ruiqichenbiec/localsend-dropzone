<Window x:Class="Dropzone.App.PinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入 PIN"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <StackPanel Margin="18" MinWidth="280">
        <TextBlock x:Name="Prompt" TextWrapping="Wrap" MaxWidth="320" Margin="0,0,0,10" />
        <TextBox x:Name="PinBox" Padding="4,3" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="确定" MinWidth="72" Padding="0,3" IsDefault="True" Click="OnOk" />
            <Button Content="取消" MinWidth="72" Padding="0,3" Margin="8,0,0,0" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
